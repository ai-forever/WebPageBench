# --- WebPageBench ---
EVAL_MOCK=bench
EVAL_FRONTEND_HOST=127.0.0.1:5173
EVAL_API_ADDRESS=localhost:9000
# EVAL_TASK_FILTER=ecommerce_basket_any_product
# EVAL_MAX_TASKS=1
# EVAL_REBUILD_DATASET=true

# --- LLM (browser-use) ---
# openai | vllm | azure | ollama | openrouter | gigachat
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# HTTP retries on transient LLM API errors (default 3).
# Also used by ouroboros-cut / full-isolated / full-evolving harnesses.
# LLM_MAX_RETRIES=3
OPENAI_API_KEY=sk-...

# OpenRouter (для envs/ и ouroboros full_*):
# Скопируйте envs/_openrouter.env.example → envs/_openrouter.env
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_PROVIDER=openrouter
# LLM_MODEL=google/gemini-2.5-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1
# ouroboros-full-* с openrouter-ouroboros: достаточно OPENROUTER_API_KEY
# (модели Ouroboros по умолчанию: google/gemini-2.5-flash для main/fallback/review)

# vLLM / OpenAI-compatible local server:
# LLM_PROVIDER=vllm
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY

# GigaChat (native SDK; см. envs/_gigachat.env.example):
# cp envs/_gigachat.env.example envs/_gigachat.env
# GIGACHAT_TOKEN=...            # access token
# GIGACHAT_CREDENTIALS=...      # or OAuth authorization key

# --- browser-use agent ---
AGENT_HARNESS=browser-use
# AGENT_HARNESS=hermes-ouroboros
AGENT_MAX_STEPS=25
AGENT_HEADLESS=true

# --- hermes-ouroboros harness (when AGENT_HARNESS=hermes-ouroboros) ---
# Установка SDK: git submodule update --init hermes-ouroboros && pip install -e ./hermes-ouroboros/sdk
# Конфиг harness: configs/hermes_ouroboros.default.json (см. docs/hermes-ouroboros-config.md)
# Локальный API: cd hermes-ouroboros && python main.py --api --host 127.0.0.1 --port 8000
# AGENT_HARNESS=hermes-ouroboros
# HERMES_CONFIG_PATH=configs/hermes_ouroboros.default.json
# HERMES_BASE_URL=http://127.0.0.1:8000
# HERMES_MODE=research
# HERMES_TIMEOUT=300
# HERMES_ON_API_ERROR=continue_with_original_task
# Публичный API (без локального сервера): HERMES_BASE_URL=https://hermes-ouroboros.online

# --- ouroboros harness (cut / full_isolated / full_evolving) ---
# AGENT_HARNESS=ouroboros-cut
# AGENT_HARNESS=ouroboros-full-isolated
# AGENT_HARNESS=ouroboros-full-evolving
# OUROBOROS_CONFIG_PATH=configs/ouroboros.cut.json
# OUROBOROS_BIN=ouroboros
# OUROBOROS_URL=http://127.0.0.1:9123
# OUROBOROS_REPO_DIR=/path/to/ouroboros
# OUROBOROS_IDENTITY_SEED_DIR=   # опционально; по умолчанию configs/ouroboros/seed/memory/
# OUROBOROS_EXECUTION_BACKEND=auto
# См. docs/ouroboros-config.md

# --- DeepEval ---
# DEEPEVAL_IDENTIFIER формируется автоматически: {EVAL_MOCK}-{AGENT_HARNESS}-{LLM_MODEL}
# (напр. bench-browser-use-gpt-4.1-mini). Переопределите вручную при необходимости:
# DEEPEVAL_IDENTIFIER=bench-browser-use-gpt-4.1-mini-v2
# Кэш DeepEval (test run, .latest_test_run.json) — автоматически $EVAL_OUTPUT_DIR/.deepeval
# при запуске через ./scripts/run_eval.sh. Задайте вручную только для особых случаев:
# DEEPEVAL_CACHE_FOLDER=/tmp/my-deepeval-cache
# Доп. аргументы deepeval test run (pytest-xdist: параллельные workers).
DEEPEVAL_EXTRA_ARGS=--num-processes 2
# Суффикс track_id на backend (авто-uuid, если не задан): изолирует event/get между прогонами.
# EVAL_TRACK_SUFFIX=smoke01
# OPENAI_API_KEY also used by optional GEval judge metrics

# Dry run: build tracks only, skip browser agent
# EVAL_DRY_RUN=true
