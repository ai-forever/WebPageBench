# Composed eval env: uitars + uitars-1.5-7b (self-hosted vLLM)
# Usage:
#   python -m bench_eval.agents.cli.serve uitars-1.5-7b     # в отдельном терминале
#   ./scripts/run_eval.sh uitars/uitars-1.5-7b

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/uitars-1.5-7b.env"
source "$_ENVS_DIR/harnesses/uitars.env"
