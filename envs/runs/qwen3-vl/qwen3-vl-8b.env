# Composed eval env: qwen3-vl + qwen3-vl-8b (self-hosted vLLM)
# Usage:
#   python -m bench_eval.agents.cli.serve qwen3-vl-8b     # в отдельном терминале
#   ./scripts/run_eval.sh qwen3-vl/qwen3-vl-8b

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/qwen3-vl-8b.env"
source "$_ENVS_DIR/harnesses/qwen3-vl.env"
