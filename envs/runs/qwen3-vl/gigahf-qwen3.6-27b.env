# Composed eval env: qwen3-vl + gigahf-qwen3.6-27b (GigaHF, модель уже развёрнута на платформе)
# Usage:
#   cp envs/_gigahf.env.example envs/_gigahf.env   # и вписать GIGAHF_TOKEN
#   ./scripts/run_eval.sh qwen3-vl/gigahf-qwen3.6-27b

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/_load_keys.sh"
load_gigahf_token "$_ENVS_DIR"
source "$_ENVS_DIR/models/gigahf-qwen3.6-27b.env"
source "$_ENVS_DIR/harnesses/qwen3-vl.env"
