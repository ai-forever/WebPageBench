# Composed eval env: jedi + jedi-7b (self-hosted vLLM)
# Usage:
#   python -m bench_eval.agents.cli.serve jedi-7b     # в отдельном терминале
#   ./scripts/run_eval.sh jedi/jedi-7b

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/jedi-7b.env"
source "$_ENVS_DIR/harnesses/jedi.env"
