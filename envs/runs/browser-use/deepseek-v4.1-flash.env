# Composed eval env: browser-use + deepseek-v4.1-flash
# Usage: ./scripts/run_eval.sh browser-use/deepseek-v4.1-flash

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/deepseek-v4.1-flash.env"
source "$_ENVS_DIR/_load_keys.sh"
load_openrouter_api_key "$_ENVS_DIR"
load_gigachat_secrets "$_ENVS_DIR"
source "$_ENVS_DIR/harnesses/browser-use.env"
