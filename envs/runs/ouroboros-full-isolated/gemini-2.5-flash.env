# Composed eval env: ouroboros-full-isolated + gemini-2.5-flash
# Usage: ./scripts/run_eval.sh ouroboros-full-isolated/gemini-2.5-flash

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/gemini-2.5-flash.env"
source "$_ENVS_DIR/_load_keys.sh"
load_openrouter_api_key "$_ENVS_DIR"
load_gigachat_secrets "$_ENVS_DIR"
source "$_ENVS_DIR/harnesses/ouroboros-full-isolated.env"
