# Composed eval env: evocua + evocua-s2 (self-hosted vLLM)
# Usage:
#   python -m bench_eval.agents.cli.serve evocua-s2     # в отдельном терминале
#   ./scripts/run_eval.sh evocua/evocua-s2

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/evocua-s2.env"
source "$_ENVS_DIR/harnesses/evocua.env"
