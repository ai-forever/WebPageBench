# Composed eval env: opencua + opencua-7b (self-hosted vLLM)
# Usage:
#   python -m bench_eval.agents.cli.serve opencua-7b     # в отдельном терминале
#   ./scripts/run_eval.sh opencua/opencua-7b

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/opencua-7b.env"
source "$_ENVS_DIR/harnesses/opencua.env"
