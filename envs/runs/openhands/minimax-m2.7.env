# Composed eval env: openhands + minimax-m2.7
# Usage: ./scripts/run_eval.sh openhands/minimax-m2.7

_ENVS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$_ENVS_DIR/_common.env"
source "$_ENVS_DIR/models/minimax-m2.7.env"
source "$_ENVS_DIR/_load_keys.sh"
load_openrouter_api_key "$_ENVS_DIR"
load_gigachat_secrets "$_ENVS_DIR"
source "$_ENVS_DIR/harnesses/openhands.env"
