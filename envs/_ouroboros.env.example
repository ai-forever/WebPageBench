# Опционально: после git submodule update --init ouroboros && ./scripts/install_ouroboros.sh
# (в активированном .venv репозитория) start_dab_ouroboros_preview.sh находит .venv/bin/ouroboros.

# OUROBOROS_REPO_DIR=ouroboros
# OUROBOROS_BIN=.venv/bin/ouroboros
# OUROBOROS_PORT=9123
# Если порт занят (типично на shared Jupyter), скрипт подберёт свободный рядом
# или задайте явно: OUROBOROS_PORT=9200
