# Shared defaults for WebPageBench eval runs (sourced by envs/runs/*).

EVAL_MOCK=bench
EVAL_FRONTEND_HOST=127.0.0.1:5173
EVAL_API_ADDRESS=localhost:9000
DAB_API_PORT=9000
VITE_API_URL=http://127.0.0.1:9000/

AGENT_MAX_STEPS=25
AGENT_HEADLESS="${AGENT_HEADLESS:-true}"
AGENT_PAGE_LOAD_WAIT=3.0
AGENT_NETWORK_IDLE_WAIT=3.0
AGENT_WAIT_BETWEEN_ACTIONS=0.5
# Дедлайн на один вызов браузера. Без него зависший клик вешает воркера
# навсегда: у page.mouse.click таймаута нет вовсе, а таймауты Playwright живут
# в node-драйвере и не срабатывают, когда заклинивает сама CDP-труба.
AGENT_ACTION_TIMEOUT="${AGENT_ACTION_TIMEOUT:-30}"

# Полные дампы запросов/ответов модели (bench_eval/agents/core/dump.py).
# Выключено: в дампах лежат base64-скриншоты, полный прогон весит сотни МБ.
# AGENT_DUMP_DIR по умолчанию — <EVAL_OUTPUT_DIR>/llm-calls.
AGENT_DUMP_ENABLED="${AGENT_DUMP_ENABLED:-false}"
# AGENT_DUMP_DIR=logs/gigahf-run
# AGENT_DUMP_IMAGES=trim
AGENT_WARMUP_TIMEOUT=45
AGENT_WARMUP_MIN_ELEMENTS=1
AGENT_BROWSER_START_TIMEOUT=180
AGENT_MAX_FAILURES=10
AGENT_LLM_TIMEOUT=120
# Optional caps for smoke or partial runs.
# AGENT_RUN_TIMEOUT=1200
# AGENT_RUN_IDLE_TIMEOUT=300
# Playwright MCP: bundled Chromium for headless environments without system Chrome.
# PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest --headless --no-sandbox --executable-path /path/to/chrome
# PLAYWRIGHT_MCP_EXECUTABLE_PATH=/path/to/playwright/chromium (auto from preflight)
# Playwright MCP per-action timeout in ms (@playwright/mcp → PLAYWRIGHT_TIMEOUT)
PLAYWRIGHT_MCP_TIMEOUT=120000

# browser-use action timeouts for heavy widgets
TIMEOUT_TypeTextEvent=120.0
TIMEOUT_BrowserStateRequestEvent=60.0
TIMEOUT_ScreenshotEvent=30.0
TIMEOUT_ClickElementEvent=30.0
TIMEOUT_NavigateToUrlEvent=30.0

# --- DeepEval ---
# Five workers can overload Chromium; start with 2 (override in shell if needed).
DEEPEVAL_EXTRA_ARGS="--num-processes 2"
