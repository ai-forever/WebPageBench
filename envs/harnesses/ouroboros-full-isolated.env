# Ouroboros full_isolated: identity + fresh drive per task
# Requires: ouroboros server on OUROBOROS_URL (port != DAB_API_PORT)
# OpenRouter: подставьте OPENROUTER_API_KEY в envs/_openrouter.env — модели синхронизируются автоматически
# Быстрый старт: ./scripts/run_eval.sh ouroboros-full-isolated/openrouter-ouroboros

DAB_OUROBOROS_BENCH_LOCK=1
AGENT_HARNESS=ouroboros-full-isolated
OUROBOROS_CONFIG_PATH=configs/ouroboros.full_isolated.json
OUROBOROS_BIN=ouroboros
OUROBOROS_URL=http://127.0.0.1:9123
OUROBOROS_REPO_DIR=ouroboros
OUROBOROS_TIMEOUT=600
AGENT_RUN_TIMEOUT=1200
AGENT_RUN_IDLE_TIMEOUT=300
