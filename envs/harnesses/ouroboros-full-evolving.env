# Ouroboros full_evolving: shared drive + evolution between tasks
# Run with a single worker only.
# OpenRouter: OPENROUTER_API_KEY в envs/_openrouter.env; см. ouroboros-full-isolated.env

DAB_OUROBOROS_BENCH_LOCK=1
AGENT_HARNESS=ouroboros-full-evolving
OUROBOROS_CONFIG_PATH=configs/ouroboros.full_evolving.json
OUROBOROS_BIN=ouroboros
OUROBOROS_URL=http://127.0.0.1:9123
OUROBOROS_REPO_DIR=ouroboros
OUROBOROS_TIMEOUT=600
AGENT_RUN_TIMEOUT=1200
AGENT_RUN_IDLE_TIMEOUT=300
DEEPEVAL_EXTRA_ARGS="--num-processes 1"
