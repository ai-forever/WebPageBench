# Claude Code (headless `claude -p`) + Playwright MCP browser tools
# Needs an Anthropic Messages endpoint: OpenRouter serves one
# (LLM_PROVIDER=openrouter); otherwise set CLAUDE_CODE_BASE_URL to an
# Anthropic-compatible proxy (e.g. LiteLLM) and CLAUDE_CODE_API_KEY.

AGENT_HARNESS=claude-code
# One Playwright MCP browser per task; keep a single worker.
DEEPEVAL_EXTRA_ARGS="--num-processes 1"
