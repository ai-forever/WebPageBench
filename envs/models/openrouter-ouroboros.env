# Ouroboros defaults via OpenRouter (cheap models for WebPageBench eval)
# Ключ: envs/_openrouter.env (общий) или OPENROUTER_API_KEY= здесь для override

LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-...   # optional override

# Синхронизируется в Ouroboros автоматически (ouroboros_llm_sync.py):
# OUROBOROS_MODEL=google/gemini-2.5-flash
# OUROBOROS_MODEL_FALLBACKS=google/gemini-2.5-flash
# OUROBOROS_REVIEW_MODELS=google/gemini-2.5-flash
