# GigaChat-3-Ultra via native GigaChat SDK (browser-use + ouroboros full_* auto-sync)
# Секреты: envs/_gigachat.env (общий) или GIGACHAT_TOKEN / GIGACHAT_CREDENTIALS здесь для override

LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://gigachat.ift.sberdevices.ru/v1
# GIGACHAT_TOKEN=...
# GIGACHAT_CREDENTIALS=...
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_VERIFY_SSL_CERTS=false
# GIGACHAT_CA_BUNDLE_FILE=
LLM_MAX_RETRIES=5
