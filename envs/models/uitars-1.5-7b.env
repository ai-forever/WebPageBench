# ByteDance-Seed/UI-TARS-1.5-7B — self-hosted через vLLM (bench_eval/agents).
# Поднять: python -m bench_eval.agents.cli.serve uitars-1.5-7b
# GUI_AGENT_BASE_URL должен указывать на этот vLLM, а не на облачный провайдер.

GUI_AGENT_MODEL=uitars-1.5-7b
GUI_AGENT_BASE_URL=${GUI_AGENT_BASE_URL:-http://127.0.0.1:8000/v1}
GUI_AGENT_API_KEY=${GUI_AGENT_API_KEY:-EMPTY}

# LLM_* нужны для именования каталога прогона и отчётов.
LLM_PROVIDER=vllm
LLM_MODEL=uitars-1.5-7b
LLM_BASE_URL=${GUI_AGENT_BASE_URL:-http://127.0.0.1:8000/v1}
