# Qwen/Qwen3-VL-8B-Instruct — self-hosted через vLLM (bench_eval/agents).
# GUI_AGENT_BASE_URL должен указывать на этот vLLM, а не на облачный провайдер.

GUI_AGENT_MODEL=qwen3-vl-8b
GUI_AGENT_SERVED_MODEL=Qwen/Qwen3.6-27B
GUI_AGENT_BASE_URL=${GUI_AGENT_BASE_URL:-http://127.0.0.1:8000/v1}
GUI_AGENT_API_KEY=${GUI_AGENT_API_KEY:-EMPTY}

# Qwen3.6-27B отдаёт координаты в НОРМАЛИЗОВАННОЙ сетке 0..999, а не в пикселях
# resized-картинки, как qwen3-vl-8b из реестра, чьей спекой мы здесь пользуемся.
# Без этой строки каждый клик уходит мимо цели (~130 px) и страница не меняется:
# агент выкручивает все AGENT_MAX_STEPS на одном экране. Проверено на том же
# чекпоинте в GigaHF — промах по пункту «Отели» 144 px против 3 px после правки.
# Строка также переключает промпт на "resolution is 1000x1000" (см. absolute в
# bench_eval/agents/qwen3_vl/agent.py), то есть согласует обе стороны.
GUI_AGENT_COORDINATE_SPACE=relative999

# --reasoning-parser qwen3: content приходит уже без <think>, но бюджет тратится
# на рассуждение — 2048 по умолчанию мало, ответ обрезается до пустого content.
GUI_AGENT_MAX_TOKENS=4096
GUI_AGENT_TIMEOUT=600
GUI_AGENT_HISTORY_N=3

# LLM_* нужны только для именования каталога прогона и отчётов.
LLM_PROVIDER=vllm
LLM_MODEL=qwen3.6-27b
LLM_BASE_URL=${GUI_AGENT_BASE_URL:-http://127.0.0.1:8000/v1}
