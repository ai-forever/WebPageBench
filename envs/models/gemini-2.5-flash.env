# google/gemini-2.5-flash via OpenRouter
# Ключ: envs/_openrouter.env (общий) или OPENROUTER_API_KEY= здесь для override
# ouroboros-full-*: main=эта модель, fallback/review — google/gemini-2.5-flash (ouroboros_llm_sync)

LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-...   # optional override
