# Qwen3.6-27B на платформе GigaHF — веса поднимать не нужно, модель уже развёрнута.
# Агент, промпт и парсер берутся из семейства qwen3_vl; меняется только транспорт.
# Требует токен: envs/_gigahf.env (см. envs/_gigahf.env.example).

GUI_AGENT_MODEL=qwen3-vl-8b
GUI_AGENT_SERVED_MODEL=Qwen3.6-27B
GUI_AGENT_PLATFORM=gigahf
GUI_AGENT_BASE_URL=${GIGAHF_BASE_URL:-https://gigahf.sberdevices.ru/api/v1}
GUI_AGENT_API_KEY=${GIGAHF_TOKEN:-}

# Чекпоинты Qwen3.6/3.8 на GigaHF отдают координаты в НОРМАЛИЗОВАННОЙ сетке 0..999,
# а не в пикселях resized-картинки, как qwen3-vl-8b из реестра. Без этой строки
# каждый клик уходит мимо на ~130 px и страница не меняется (проверено: пункт
# «Отели» — промах 144 px против 3 px после переключения).
GUI_AGENT_COORDINATE_SPACE=relative999

# Синхронный /chat/completions ограничен 10 запросами в минуту на IP, а один
# таск тратит до AGENT_MAX_STEPS вызовов — поэтому идём через async submit/poll.
GIGAHF_MODE=async
GIGAHF_POLL_INTERVAL=2
GIGAHF_POLL_TIMEOUT=900

# Qwen3.x рассуждает перед ответом: 2048 по умолчанию мало, content обрезается.
GUI_AGENT_MAX_TOKENS=4096
GUI_AGENT_TIMEOUT=600
GUI_AGENT_HISTORY_N=3

# LLM_* нужны только для именования каталога прогона и отчётов.
LLM_PROVIDER=gigahf
LLM_MODEL=gigahf-qwen3.6-27b
LLM_BASE_URL=${GIGAHF_BASE_URL:-https://gigahf.sberdevices.ru/api/v1}
