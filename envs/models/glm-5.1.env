# z-ai/glm-5.1 via OpenRouter
# Ключ: envs/_openrouter.env (общий) или OPENROUTER_API_KEY= здесь для override
# ouroboros-full-*: main=эта модель; review/scope/deep-self-review=google/gemini-2.5-flash
# Стоимость в лидерборде: export DAB_MODEL_PRICING_OVERRIDES=envs/model_pricing_overrides.json

LLM_PROVIDER=openrouter
LLM_MODEL=z-ai/glm-5.1
LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-...   # optional override
